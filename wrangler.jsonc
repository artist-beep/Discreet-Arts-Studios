{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "discrete-art-studio",
  "main": "server/worker.mjs",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"],
  },
  // At the approved hosting stage, add the real D1 database binding "DB" and
  // its database_id and migrations_dir "migrations". Set FORM_TIMING_SECRET privately.
}
